# TinyTS-Scientist Configuration
# Copy to .env and fill in your values: cp .env.example .env

# ── LLM Provider ─────────────────────────────────────────────
# "cerebras" (cloud, free tier) or "ollama" (local)
LLM_PROVIDER=cerebras

# ── Cerebras (default) ───────────────────────────────────────
CEREBRAS_API_KEY=your_key_here
CEREBRAS_MODEL=llama-3.3-70b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# ── Ollama (alternative — local, privacy-preserving) ─────────
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# ── Temperature ──────────────────────────────────────────────
# Routing (query understanding, tool selection): low for determinism
ROUTING_TEMPERATURE=0.1
# Synthesis (report generation, explanations): higher for fluency
SYNTHESIS_TEMPERATURE=0.7

# ── System ───────────────────────────────────────────────────
DEVICE=cpu
RANDOM_SEED=42
LOG_LEVEL=INFO
